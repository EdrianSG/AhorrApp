<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/navigation_home"
        android:name="com.example.ahorrapp.HomeFragment"
        android:label="Inicio">
        <action
            android:id="@+id/action_homeFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/navigation_summary"
        android:name="com.example.ahorrapp.SummaryFragment"
        android:label="Resumen" />

    <fragment
        android:id="@+id/navigation_calendar"
        android:name="com.example.ahorrapp.ui.calendar.CalendarFragment"
        android:label="Calendario" />

    <fragment
        android:id="@+id/navigation_scheduled"
        android:name="com.example.ahorrapp.ui.scheduled.ScheduledPaymentsFragment"
        android:label="Pagos Programados" />

    <fragment
        android:id="@+id/navigation_settings"
        android:name="com.example.ahorrapp.SettingsFragment"
        android:label="Ajustes">
        <action
            android:id="@+id/action_settingsFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_settingsFragment_to_notificationSettingsFragment"
            app:destination="@id/notificationSettingsFragment" />
    </fragment>

    <fragment
        android:id="@+id/notificationSettingsFragment"
        android:name="com.example.ahorrapp.ui.notifications.NotificationSettingsFragment"
        android:label="Configuración de Notificaciones" />

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.ahorrapp.ui.auth.LoginFragment"
        android:label="Iniciar Sesión">
        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_loginFragment_to_homeFragment"
            app:destination="@id/navigation_home"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.ahorrapp.ui.auth.RegisterFragment"
        android:label="Registro">
        <action
            android:id="@+id/action_registerFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
    </fragment>

</navigation> 