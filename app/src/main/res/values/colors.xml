    <!-- El sistema actualiza estos colores dinámicamente según el tema seleccionado -->
    <!-- Por defecto apuntan a verde, pero se actualizarán según la preferencia guardada -->
    <!-- NOTA: Estos colores se actualizan cuando se recree la actividad después de cambiar el color -->
