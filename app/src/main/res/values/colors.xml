    <!-- IMPORTANTE: Estos colores se actualizan usando código que lee la preferencia guardada -->
    <!-- El sistema lee la preferencia "color_theme" y actualiza estos colores dinámicamente -->
    <!-- Por defecto apuntan a verde, pero se actualizarán según la preferencia guardada -->
    <color name="dynamic_primary_200">@color/green_primary_200</color>
    <color name="dynamic_primary_500">@color/green_primary_500</color>
    <color name="dynamic_primary_700">@color/green_primary_700</color>
